# ─── Azampay App Credentials ─────────────────────────────────────────────────
APP_NAME=Your App Name
CLIENT_ID=your-client-id-here
CLIENT_SECRET=your-client-secret-here

# ─── Base URLs ────────────────────────────────────────────────────────────────
# Test environment
AUTH_BASE_URL=https://authenticator-test.azampay.co.tz
DISBURSE_BASE_URL=https://api-disbursement-test.azampay.co.tz
BALANCE_BASE_URL=https://api-disbursement-test.azampay.co.tz

# Production environment (uncomment when ready)
# AUTH_BASE_URL=https://authenticator.azampay.co.tz
# DISBURSE_BASE_URL=https://api-disbursement.azampay.co.tz
# BALANCE_BASE_URL=https://api-disbursement.azampay.co.tz

# ─── RSA Public Key ───────────────────────────────────────────────────────────
# Paste your full PEM public key from the Azampay dashboard
PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
<your-public-key-here>
-----END PUBLIC KEY-----"
